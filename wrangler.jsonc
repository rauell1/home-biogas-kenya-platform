{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-biogas-kenya-platform",
  // OpenNext refreshes stale cached pages (revalidate) by calling this Worker
  // through this binding; without it the refresh is skipped and every
  // request renders the page again.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "home-biogas-kenya-platform" }],
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Run the Worker near its database and APIs rather than near each visitor.
  // Without this, every query from a page in Nairobi would cross to the
  // database region and back, which is slower than Vercel's single region.
  "placement": { "mode": "smart" },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Runtime secrets are set with `npx wrangler secret put NAME` or in the Cloudflare dashboard.
  "keep_vars": true,
  "workers_dev": true,
  // Add a custom domain once it is on this Cloudflare account, e.g.
  // "routes": [{ "pattern": "example.co.ke", "custom_domain": true }],
  "observability": { "enabled": true },
  // Page cache for open-next.config.ts.
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "5f4ed96567204471820e051f4bc52c1f" },
    { "binding": "NEXT_TAG_CACHE_KV", "id": "5a4d34dba93e4ed5b712d936732a11e9" }
  ]
}
